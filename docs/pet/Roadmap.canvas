		{"id":"00d7188e056bc20e","type":"text","text":"# Roadmap","x":-140,"y":-320,"width":285,"height":90},
		{"id":"66bea10e0fdc0b1e","type":"text","text":"Самое базоое приложение\n\n- [ ] Окно\n- [ ] Чтоб открыло zip по ссылке\n- [ ] Чтоб запускало ежа\n\nНеобязательное:\n- [ ] Настроечки(render config)\n- [ ] ЦВет чтоб менять можно было\n- [ ] Автозапуск с компом\n- [ ] Иконка yoji","x":-620,"y":260,"width":318,"height":420},
		{"id":"940aba0c652e8bb3","type":"text","text":"YOJI \n\n- [ ] Запаковать в удобный zip\n- [ ] а\n\nНеобязательное:\n\n- [ ] Звук\n- [ ] Менюшка ПКМ\n- [ ] Плагины\n- [ ] Хитбоксы\n- [ ] Предметы\n- [ ] Куча сего короче, это прям на потом","x":-220,"y":260,"width":250,"height":420},
		{"id":"4957a82747938ff2","type":"text","text":"Сайт\n\n- [ ] Кнопка скачать\n- [ ] Описание проекта\n- [ ] Ссылочка куда нам донатить\n\nНеобязательное:\n\n- [ ] Адаптиность\n- [ ] Красиые приколюшки\n- [ ] Пасхалки\n- [ ] ","x":110,"y":260,"width":250,"height":420},
		{"id":"bea5d10ef56c8630","type":"text","text":"Социальные сети\n\nСоздать:\n- [ ] Ютуб каналы\n- [ ] Дискорд\n- [ ] Х ?\n- [ ] Ну и первое видео сделать везде\n\nПотом создать:\n- [ ] Патреон или бусти","x":460,"y":260,"width":250,"height":420},
